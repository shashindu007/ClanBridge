{
  "name": "clanbridge",
  "version": "0.1.0",
  "private": true,
  "description": "Clash of Clans clan management platform for three clans. See IMPLEMENTATION.md.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "sync:clans": "tsx --env-file-if-exists=.env.local scripts/sync/clans.ts",
    "sync:cwl": "tsx --env-file-if-exists=.env.local scripts/sync/cwl.ts",
    "sync:war": "tsx --env-file-if-exists=.env.local scripts/sync/war.ts",
    "sync:raids": "tsx --env-file-if-exists=.env.local scripts/sync/raids.ts",
    "sync:clan-games": "tsx --env-file-if-exists=.env.local scripts/sync/clan-games.ts",
    "sync:players": "tsx --env-file-if-exists=.env.local scripts/sync/players.ts",
    "sync:health": "tsx --env-file-if-exists=.env.local scripts/sync/health.ts",
    "icons": "tsx scripts/make-icons.ts",
    "game-data": "tsx scripts/game-data.ts",
    "game-art": "tsx scripts/game-art.ts",
    "fixtures:capture": "tsx --env-file=.env.local scripts/capture-fixtures.ts",
    "fixtures:seed": "tsx scripts/seed-fixtures.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "supabase:check": "tsx --env-file=.env.local scripts/check-supabase.ts",
    "migrations:bundle": "tsx scripts/build-migration-bundle.ts",
    "migrations:apply": "tsx --env-file=.env.local scripts/apply-migrations.ts",
    "restore:verify": "tsx --env-file=.env.local scripts/restore-verify.ts",
    "types:db": "tsx --env-file=.env.local scripts/gen-db-types.ts",
    "avatars:cleanup": "tsx --env-file=.env.local scripts/cleanup-avatars.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "@tanstack/react-query": "^5.90.2",
    "@upstash/ratelimit": "^2.0.6",
    "@upstash/redis": "^1.35.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.28.0",
    "next": "^15.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "pg": "^8.22.0",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
