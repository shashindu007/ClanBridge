# ClanBridge environment variables
#
# Copy to .env.local and fill in after Phase 0. This file is committed; .env.local is not.
#
# R6 — SECRETS NEVER REACH VERCEL.
# The two groups below are not interchangeable. If anything from GROUP B ends up in a
# Vercel environment variable, the architecture has drifted: the web app has no reason
# to hold a Clash of Clans token or a Supabase service key, because it never calls the
# game API (R1) and never bypasses RLS.


# ─────────────────────────────────────────────────────────────────────────────
# GROUP A — Vercel-safe. Set these in Vercel, in GitHub Actions, and locally.
# ─────────────────────────────────────────────────────────────────────────────

# T0.7 — Supabase project URL and anon key. The anon key is public by design;
# RLS (T1.9) is what protects the data, not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute site URL. Used for magic-link redirects (T3.1) and push payload links (T5.6).
# Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# T0.10 — VAPID public key. Shipped to the browser during push subscription (T5.5).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# T0.9 — Upstash Redis REST credentials. Rate limiting only (T3.3, T9.7).
# Never used as a data cache — the database is the cache (section 3).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
# GROUP B — GitHub Actions secrets and .env.local. Not in Vercel, except where
# noted for COC_API_TOKEN below.
# ─────────────────────────────────────────────────────────────────────────────

# T0.4 / T0.5 — Clash of Clans API token.
#
# Read by scripts/sync/ (R1), AND by /api/verify on Vercel (T3.3) — the one
# documented exception in R6. That route performs Supercell's verifytoken
# handshake for a member signing up, which cannot be done from a sync job.
# It is rate limited to 5 attempts per user per hour.
#
# The dev key is bound to your home IP; the production key to the RoyaleAPI
# proxy IP. Vercel has no fixed egress IP, so it must use the proxy key.
COC_API_TOKEN=

# API base URL. The key you use must match the IP the base URL resolves from.
#   local, dev key:        https://api.clashofclans.com/v1
#   GitHub Actions, prod:  https://cocproxy.royaleapi.dev/v1
COC_API_BASE=https://api.clashofclans.com/v1

# T2.3 — read fixtures/ instead of the network. Set true for all offline development;
# the whole client must work with this on (section 6, definition of done).
USE_FIXTURES=true

# T0.7 — Supabase project URL for scripts and GitHub Actions.
#
# The same value as NEXT_PUBLIC_SUPABASE_URL. It exists separately because T2.7
# names SUPABASE_URL as the Actions secret, and a workflow should not have to
# carry a NEXT_PUBLIC_-prefixed variable to run a Node script. admin.ts reads
# this first and falls back to the NEXT_PUBLIC_ one locally.
SUPABASE_URL=

# T0.7 — Supabase service role key. Bypasses RLS entirely.
# Used only by src/lib/supabase/admin.ts, which is imported only by scripts/.
SUPABASE_SERVICE_KEY=

# T2.8 — direct Postgres connection string for pg_dump in the backup workflow.
SUPABASE_DB_URL=

# T0.10 — VAPID private key and contact subject (a mailto: URL).
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=


# ─────────────────────────────────────────────────────────────────────────────
# TEST-ONLY OVERRIDES — never set these in any deployed environment.
#
# The API client reads its call spacing and retry backoff from these so the test
# suite does not sleep for real. Production relies on the defaults, which are the
# values the spec requires: 200 ms between calls, 500 ms base backoff. Shortening
# them in a sync job is the bug they exist to avoid.
# ─────────────────────────────────────────────────────────────────────────────
# COC_THROTTLE_MS=200
# COC_BACKOFF_MS=500
