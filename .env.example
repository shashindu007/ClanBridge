# ClanBridge environment variables
#
# Copy to .env.local and fill in after Phase 0. This file is committed; .env.local is not.
#
# R6 — SECRETS NEVER REACH VERCEL.
# The two groups below are not interchangeable. If anything from GROUP B ends up in a
# Vercel environment variable, the architecture has drifted: the web app has no reason
# to hold a Clash of Clans token or a Supabase service key, because it never calls the
# game API (R1) and never bypasses RLS.


# ─────────────────────────────────────────────────────────────────────────────
# GROUP A — Vercel-safe. Set these in Vercel, in GitHub Actions, and locally.
# ─────────────────────────────────────────────────────────────────────────────

# T0.7 — Supabase project URL and anon key. The anon key is public by design;
# RLS (T1.9) is what protects the data, not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute site URL. Used for magic-link redirects (T3.1) and push payload links (T5.6).
# Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# T0.10 — VAPID public key. Shipped to the browser during push subscription (T5.5).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# T0.9 — Upstash Redis REST credentials. Rate limiting only (T3.3, T9.7).
# Never used as a data cache — the database is the cache (section 3).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The one account allowed to claim platform ownership (migration 015).
#
# Not a secret — it is an email address, and knowing it grants nothing. It is the
# second of two independent checks: claim_platform_ownership() already refuses if
# any platform admin exists, and /admin additionally refuses unless the signed-in
# address matches this. Two checks because the window between the first sign-in
# and the claim is the one moment this system has no owner to defend it.
#
# Set it before you first sign in. Leave it empty and nobody can claim ownership,
# which is the safe failure.
OWNER_EMAIL=


# ─────────────────────────────────────────────────────────────────────────────
# GROUP B — GitHub Actions secrets and .env.local. Not in Vercel, except where
# noted for COC_API_TOKEN below.
# ─────────────────────────────────────────────────────────────────────────────

# T0.4 / T0.5 — Clash of Clans API token.
#
# Read by scripts/sync/ (R1), AND by /api/verify on Vercel (T3.3) — the one
# documented exception in R6. That route performs Supercell's verifytoken
# handshake for a member signing up, which cannot be done from a sync job.
# It is rate limited to 5 attempts per user per hour.
#
# The dev key is bound to your home IP; the production key to the RoyaleAPI
# proxy IP. Vercel has no fixed egress IP, so it must use the proxy key.
COC_API_TOKEN=

# API base URL. The key you use must match the IP the base URL resolves from.
#   local, dev key:        https://api.clashofclans.com/v1
#   GitHub Actions, prod:  https://cocproxy.royaleapi.dev/v1
COC_API_BASE=https://api.clashofclans.com/v1

# T2.3 — read fixtures/ instead of the network. Set true for all offline development;
# the whole client must work with this on (section 6, definition of done).
USE_FIXTURES=true

# T0.7 — Supabase project URL for scripts and GitHub Actions.
#
# The same value as NEXT_PUBLIC_SUPABASE_URL. It exists separately because T2.7
# names SUPABASE_URL as the Actions secret, and a workflow should not have to
# carry a NEXT_PUBLIC_-prefixed variable to run a Node script. admin.ts reads
# this first and falls back to the NEXT_PUBLIC_ one locally.
SUPABASE_URL=

# T0.7 — Supabase service role key. Bypasses RLS entirely.
# Used only by src/lib/supabase/admin.ts, which is imported only by scripts/.
SUPABASE_SERVICE_KEY=

# T2.8 — Postgres connection string for pg_dump in the backup workflow. Use the
# SESSION POOLER string (*.pooler.supabase.com:5432): the direct
# db.<ref>.supabase.co address is IPv6-only and GitHub's runners cannot reach it.
SUPABASE_DB_URL=

# Encrypts the weekly backup (backup.yml), which is an artifact of a PUBLIC
# repository. A GitHub Actions secret; set it here only when running
# `npm run restore:verify` on an encrypted .gpg dump. Lose it and every backup
# made with it is unreadable.
BACKUP_PASSPHRASE=

# T0.10 — VAPID private key and contact subject (a mailto: URL).
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=


# ─────────────────────────────────────────────────────────────────────────────
# T9.4 — where `npm run restore:verify` restores a backup to. OPTIONAL, and
# TEMPORARY: set it while running the restore test, then clear it again.
#
# A SCRATCH Supabase project, never this one. The script compares it against
# SUPABASE_DB_URL above and refuses outright if they match — a restore is the
# only operation in this project that destroys rather than appends, and it
# passes through no policy, grant or definer function, so R4 does not protect
# against it.
#
# It lives here rather than being passed as `--into` because npm echoes the
# command it runs, which would put a database password in your shell history and
# leave it there long after the scratch project is deleted.
# ─────────────────────────────────────────────────────────────────────────────
RESTORE_TARGET_URL=


# ─────────────────────────────────────────────────────────────────────────────
# TEST-ONLY OVERRIDES — never set these in any deployed environment.
#
# The API client reads its call spacing and retry backoff from these so the test
# suite does not sleep for real. Production relies on the defaults, which are the
# values the spec requires: 200 ms between calls, 500 ms base backoff. Shortening
# them in a sync job is the bug they exist to avoid.
# ─────────────────────────────────────────────────────────────────────────────
# COC_THROTTLE_MS=200
# COC_BACKOFF_MS=500


# ─────────────────────────────────────────────────────────────────────────────
# T9.2 — manual sync trigger from /admin. OPTIONAL.
#
# Without these the admin page explains that manual runs are not configured and
# points at the Actions tab, rather than offering a button that always fails.
#
# R6 IS NOT BROKEN BY THIS. A fine-grained PAT scoped to Actions (read and
# write) on this repository alone is neither the Supabase service key nor the
# Clash of Clans token: the web app still cannot bypass RLS and still cannot
# read game data. A leak lets someone run this repo's workflows, which are
# idempotent (R5) and write only game facts — the cost is throttling and wasted
# Actions minutes, not altered data.
#
# Vercel-safe, unlike GROUP B above.
# ─────────────────────────────────────────────────────────────────────────────
GITHUB_DISPATCH_TOKEN=
GITHUB_DISPATCH_REPO=
# Branch the dispatched workflow runs from. Defaults to main.
GITHUB_DISPATCH_REF=
